# Copy to secrets.yaml (git-ignored) and fill in.
#
#   cp secrets.yaml.example secrets.yaml
#
# The two SIMPLE / teaching configs only use the first four values.
# The two FULL configs additionally use web_server_username / _password.

# --- Wi-Fi the devices join once onboarded via the captive portal -----------
wifi_ssid: "YourNetwork-2.4G"
wifi_password: "your-wifi-password"

# --- Fallback AP each device raises on first boot / when Wi-Fi is lost ------
# You connect a phone to this to run the captive portal. Same value is fine
# for both devices (their AP SSIDs differ: "dehumidifier-controller" /
# "dehumidifier-plug").
fallback_ap_password: "dehumidify"          # >= 8 chars

# --- OTA (esphome upload) password -----------------------------------------
ota_password: "change-me-ota"

# ===========================================================================
#  FULL configs only below this line
# ===========================================================================

# --- web_server basic-auth --------------------------------------------------
# Gates the web UI AND the REST relay endpoint on BOTH full devices. The plug
# checks the incoming header against these; the controller builds a matching
# "Authorization: Basic <base64>" header from these at runtime (no manual
# encoding step). Keep the password free of  "  \  $  — it is substituted into
# a C++ string literal at compile time.
web_server_username: "admin"
web_server_password: "change-me-web"
